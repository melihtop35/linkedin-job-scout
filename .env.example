# ==============================================================================
# LinkedIn Job Scout - Çevre Değişkenleri Şablonu
# ==============================================================================
# Bu dosyayı ".env" olarak kullanın ve kendi bilgilerinizi girin.
# ==============================================================================

# --- MOD A: Doğrudan Ollama Cloud API (Önerilen) ---
# ollama.com/settings/keys adresinden alacağınız API anahtarını yapıştırın.
OLLAMA_API_KEY=

# Ollama Cloud OpenAI-uyumlu uç noktası
OPENAI_ENDPOINT=https://ollama.com/v1

# --- MOD B: Yerel Ollama Köprüsü / Daemon (Opsiyonel) ---
# Bilgisayarınızda Ollama kuruluysa ve "ollama signin" yaptıysanız kullanılır.
OLLAMA_ENDPOINT=http://host.docker.internal:11434

# Varsayılan LLM Modeli
# Mod A için: gemma4:31b (veya gemma4)
# Mod B için: gemma4:cloud, gemma4:31b-cloud veya yerel gemma4:e4b
DEFAULT_LLM_MODEL=gemma4:31b

# --- Güvenlik ve Tarayıcı Ayarları ---
# noVNC canlı tarayıcı ekranına (http://localhost:6080) giriş şifresi
VNC_PASSWORD=guvenlisifre123

# Anonim telemetri gönderimini kapatır
ANONYMIZED_TELEMETRY=false
