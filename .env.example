# ==============================================================================
# AI Job Scout (LinkedIn <-> Kariyer.net Zincir Otomasyonu) - Şablon
# ==============================================================================

# Zincir Sırası: linkedin,kariyer (Varsayılan) veya kariyer,linkedin
CHAIN_ORDER=linkedin,kariyer
JOBS_PER_PLATFORM=20

# --- MOD A: Doğrudan Ollama Cloud API (Opsiyonel) ---
OLLAMA_API_KEY=
OPENAI_ENDPOINT=https://ollama.com/v1

# --- MOD B: Yerel Ollama Köprüsü / Daemon (Varsayılan) ---
OLLAMA_ENDPOINT=http://host.docker.internal:11434

# Varsayılan LLM Modeli
DEFAULT_LLM_MODEL=gemma4:12b

# --- Güvenlik ve Tarayıcı Ayarları ---
VNC_PASSWORD=guvenlisifre123
ANONYMIZED_TELEMETRY=false
